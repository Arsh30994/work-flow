# SoulCare Backend Environment Variables
# Copy this file to .env and fill in your values.

# Demo mode: mock AI when true or when no API key is set
DEMO_MODE=true

# MongoDB (required for persistence; chat still works if Mongo is down)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=soulcare
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority

# Google Gemini API key (optional when DEMO_MODE=true)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional model override (default tries gemini-flash-latest, then fallbacks)
# GEMINI_MODEL=gemini-flash-latest

# Admin dashboard auth header: X-Admin-Token
ADMIN_TOKEN=soulcare-demo-admin

# JWT auth (Authorization: Bearer <token>)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Optional password hashing salt (defaults to demo salt)
# AUTH_SALT=soulcare-demo-salt

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
